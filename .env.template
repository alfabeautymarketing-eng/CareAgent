# =================================================================
# AgentCare - Шаблон конфигурации (.env.template)
# =================================================================
# Инструкция:
# 1. Скопируйте этот файл в .env: cp .env.template .env
# 2. Заполните необходимые значения ниже.
# 3. Файлы учетных данных должны быть в папке config/

# ============== Основные настройки приложения ==============
APP_NAME=AgentCare
ENVIRONMENT=production # development, testing, production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=generate-a-secure-key-here
TIMEZONE=Europe/Moscow

# ============== Настройки Сервера (FastAPI) ==============
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
RELOAD=false
TIMEOUT_KEEP_ALIVE=60

# ============== Google Cloud & APIs ==============
# Путь к JSON-файлу сервисного аккаунта
GOOGLE_CREDENTIALS_FILE=config/credentials.json
# Альтернатива (Base64 для Docker/CI)
# GOOGLE_CREDENTIALS_BASE64=

# Scopes для Google APIs
GOOGLE_API_SCOPES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive

# ============== Supabase ==============
# Get from Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_LLXE5vAw5EM9tnLrm6SA6Q_3Cp7YySQ

# ============== Gemini AI ==============
GEMINI_API_KEY=your-gemini-api-key-here
# Модели: gemini-1.5-pro, gemini-1.5-flash, gemini-2.5-flash (если доступна)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2

# ============== Redis (Кэширование и Очереди) ==============
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=20

# ============== База данных (Supabase/PostgreSQL) ==============
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=public

# ============== Проекты и Таблицы (Spreadsheet IDs) ==============
# MT - MakeTrue
MT_SPREADSHEET_ID=
MT_SOURCE_DOC_ID=
MT_TRIAL_DOC_ID=

# SK - SkinHelpers
SK_SPREADSHEET_ID=
SK_SOURCE_DOC_ID=
SK_SAMPLES_DOC_ID=

# SS - SmartSolutions
SS_SPREADSHEET_ID=
SS_SOURCE_DOC_ID=

# ============== Синхронизация (Sync Engine) ==============
SYNC_BATCH_SIZE=100
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=5
SYNC_PARALLEL_TASKS=5
SYNC_TIMEOUT=60
SYNC_LOG_ENABLED=true

# ============== Обработка Прайс-листов (Price Processor) ==============
PRICE_AUTO_SYNC=true
PRICE_BACKUP_ENABLED=true
PRICE_SNAPSHOT_PATH=data/snapshots/
PRICE_MAX_ROWS=10000
PRICE_USE_AI_MATCHING=true

# ============== Сертификация и Характеристики ==============
CERT_DEFAULT_SPIRIT_PERCENT=0
CERT_AUTO_CALC_SPIRITS=true
CERT_RE-CALC_ON_PRICE_UPDATE=true

# ============== Инвойсы и Документы ==============
INVOICE_TEMPLATE_ID=
INVOICE_SAVE_DIR=data/invoices/
INVOICE_AUTO_GENERATE=false
DRIVE_ARCHIVE_FOLDER_ID=

# ============== Безопасность Webhooks ==============
# Секрет для проверки подписи от Google Apps Script
WEBHOOK_SECRET=your-secure-webhook-secret
# Разрешенные IP-адреса (опционально)
ALLOWED_HOSTS=127.0.0.1,localhost

# ============== Логирование и Мониторинг ==============
# Пути к файлам логов
LOG_FILE_PATH=logs/app.log
SYNC_LOG_DIR=data/sync_logs/
FUNC_LOG_DIR=data/function_logs/

# Ротация логов
LOG_MAX_BYTES=10485760 # 10MB
LOG_BACKUP_COUNT=5

# ============== Уведомления (Telegram) ==============
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON_ERROR=true
TELEGRAM_NOTIFY_ON_SYNC_FINISH=false

# ============== Docker Config ==============
DOCKER_APP_IMAGE=agentcare-app
DOCKER_REDIS_IMAGE=redis:7-alpine
DOCKER_RESTART_POLICY=always

# ============== Разное ==============
AUTO_CLEANUP_DAYS=90
MAX_CONCURRENT_PDF_PROCESSORS=2
PDF_TEMP_DIR=data/temp_pdf/
ENABLE_QUERY_CACHE=true
