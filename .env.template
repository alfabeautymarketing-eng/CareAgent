# AgentCare Environment Configuration Template
# Copy this file to .env and fill in with your actual values
# DO NOT commit .env file to version control

################################################################################
# Application Settings
################################################################################

# Application name and environment
APP_NAME=AgentCare
ENVIRONMENT=development
DEBUG=false

# Version (automatically set from package info)
APP_VERSION=0.1.0

################################################################################
# Server Configuration
################################################################################

# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Number of Uvicorn workers
SERVER_WORKERS=4

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=100

# Request timeout (seconds)
REQUEST_TIMEOUT=300

################################################################################
# Database & Cache
################################################################################

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=10
REDIS_RETRY_ON_TIMEOUT=true

# Cache TTL (Time To Live) in seconds
CACHE_TTL=3600

################################################################################
# Google Cloud Services
################################################################################

# Google Service Account credentials file path
GOOGLE_CREDENTIALS_FILE=config/credentials.json

# For Docker deployments, you can also use base64 encoded credentials
# GOOGLE_CREDENTIALS_BASE64=<base64-encoded-credentials>

# Optional: Specific Google project (auto-detected from credentials.json)
GOOGLE_PROJECT_ID=

################################################################################
# Gemini AI Configuration
################################################################################

# Gemini API Key
# Get from: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=

# Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# AI Service Settings
GEMINI_MAX_RETRIES=5
GEMINI_TIMEOUT=30
GEMINI_TEMPERATURE=0.7

# Rate limiting
AI_RATE_LIMIT=30  # Requests per minute

################################################################################
# Supabase PostgreSQL Database (Optional)
################################################################################

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (for server-side operations)
# WARNING: Keep this secret, use only on server
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anonymous key (if needed for client-side)
SUPABASE_ANON_KEY=

# Database connection settings
SUPABASE_DB_TIMEOUT=10
SUPABASE_POOL_SIZE=5

################################################################################
# Logging Configuration
################################################################################

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=json

# Log output file (relative to project root)
LOG_FILE=logs/app.log

# Maximum log file size (MB)
LOG_MAX_SIZE=100

# Number of backup log files to keep
LOG_BACKUP_COUNT=10

# Structured logging
STRUCTLOG_ENABLED=true

################################################################################
# Sync Configuration
################################################################################

# Batch size for sync operations
SYNC_BATCH_SIZE=100

# Sync timeout (seconds)
SYNC_TIMEOUT=300

# Lock timeout to prevent deadlocks (seconds)
SYNC_LOCK_TIMEOUT=30

# Maximum retries for sync operations
SYNC_MAX_RETRIES=3

# Rate limiting
SYNC_RATE_LIMIT=20  # Requests per minute

################################################################################
# Webhook Configuration
################################################################################

# Secret key for webhook signature verification
WEBHOOK_SECRET=generate-a-random-string-here

# Webhook validation timeout (seconds)
WEBHOOK_TIMEOUT=30

# Rate limiting
WEBHOOK_RATE_LIMIT=100  # Requests per minute

################################################################################
# Google Sheets Integration
################################################################################

# Price API rate limiting
PRICE_RATE_LIMIT=5  # Requests per minute

# Sheets API rate limiting
SHEETS_RATE_LIMIT=100  # Requests per minute

# Sheet operation timeout (seconds)
SHEETS_TIMEOUT=60

################################################################################
# Data Persistence
################################################################################

# Data directory (for logs and sync records)
DATA_DIR=data

# Sync logs directory
SYNC_LOGS_DIR=data/sync_logs

# Function logs directory
FUNCTION_LOGS_DIR=data/function_logs

# Log retention days
LOG_RETENTION_DAYS=90

# Maximum sync log entries
MAX_SYNC_LOGS=200000

################################################################################
# Optional: Telegram Integration
################################################################################

# Telegram bot token (optional)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID for notifications (optional)
TELEGRAM_CHAT_ID=

# Enable/disable Telegram notifications
TELEGRAM_ENABLED=false

################################################################################
# Optional: Error Tracking (Sentry)
################################################################################

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Sentry environment
SENTRY_ENVIRONMENT=development

# Enable/disable Sentry
SENTRY_ENABLED=false

################################################################################
# Optional: Monitoring & Analytics
################################################################################

# Prometheus metrics endpoint
PROMETHEUS_ENABLED=false

# StatsD configuration (for monitoring)
STATSD_HOST=localhost
STATSD_PORT=8125

################################################################################
# Development & Testing
################################################################################

# Enable verbose logging for debugging
VERBOSE_LOGGING=false

# Enable test mode
TEST_MODE=false

# Test database URL (for running tests)
TEST_DATABASE_URL=

################################################################################
# Security
################################################################################

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# CORS allow credentials
CORS_ALLOW_CREDENTIALS=true

# CORS allow methods
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS

# CORS allow headers
CORS_ALLOW_HEADERS=Content-Type,Authorization

# Session timeout (minutes)
SESSION_TIMEOUT=60

################################################################################
# Notes
################################################################################

# To use this template:
# 1. Copy this file to .env: cp .env.template .env
# 2. Fill in all required values (marked with "Generate" or "your-value")
# 3. Keep .env secure - add to .gitignore
# 4. Never commit secrets to version control
#
# For production:
# 1. Use secure secret management (e.g., AWS Secrets Manager, HashiCorp Vault)
# 2. Enable HTTPS/TLS
# 3. Set DEBUG=false
# 4. Use strong WEBHOOK_SECRET
# 5. Enable SENTRY_ENABLED for error tracking
# 6. Restrict CORS_ORIGINS to specific domains
#
# For Google Sheets setup:
# 1. Create a Google Cloud project
# 2. Create a service account
# 3. Download JSON key file
# 4. Save to config/credentials.json
# 5. Share Google Sheets with service account email
#
# For Supabase setup:
# 1. Create a Supabase project
# 2. Create a PostgreSQL database
# 3. Get URL and service role key from project settings
# 4. Run migrations: scripts/supabase_sync.py
